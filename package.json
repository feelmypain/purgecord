{
  "name": "purgecord",
  "nameFull": "Purgecord",
  "version": "1.0.2",
  "description": "Bulk-delete your own messages in a Discord channel, DM or server",
  "userScript": {
    "namespace": "https://github.com/feelmypain/purgecord",
    "match": [
      "https://*.discord.com/app",
      "https://*.discord.com/channels/*",
      "https://*.discord.com/login"
    ],
    "icon": "https://raw.githubusercontent.com/feelmypain/purgecord/main/images/icon128.png",
    "downloadURL": "https://raw.githubusercontent.com/feelmypain/purgecord/main/purgecord.user.js",
    "grant": "none",
    "attribution": "Fork of Undiscord by victornpb (https://github.com/victornpb/undiscord), MIT",
    "updateURL": "https://raw.githubusercontent.com/feelmypain/purgecord/main/purgecord.user.js"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feelmypain/purgecord.git"
  },
  "bugs": {
    "url": "https://github.com/feelmypain/purgecord/issues"
  },
  "homepage": "https://github.com/feelmypain/purgecord",
  "author": "feelmypain",
  "main": "purgecord.user.js",
  "scripts": {
    "start": "npm run watch",
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "prebuild": "rimraf dist",
    "test": "npm run lint && npm run test:unit && npm run build",
    "test:unit": "node --test test/*.test.mjs",
    "lint": "eslint --ext .js,.mjs src test",
    "lint:fix": "eslint --ext .js,.mjs src test --fix",
    "version": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "delete",
    "messages",
    "discord",
    "wipe",
    "purge",
    "clean",
    "bulk"
  ],
  "devDependencies": {
    "@rollup/plugin-json": "^6.0.0",
    "eslint": "^8.36.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.0",
    "rimraf": "^4.4.1",
    "rollup": "^3.20.2",
    "rollup-plugin-baked-env": "^1.0.1",
    "rollup-plugin-banner2": "^1.2.2",
    "rollup-plugin-commonjs": "^10.1.0",
    "rollup-plugin-node-resolve": "^5.2.0",
    "rollup-plugin-serve": "^2.0.2",
    "tiny-dedent": "^1.0.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.js": "npm run lint"
  }
}
